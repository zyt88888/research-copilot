# 开箱即用配置：LLM_API_KEY 留空 = 离线演示模式（功能全可用，LLM 模块自动降级）
# 填入任意 OpenAI 兼容网关的 Key 后全部模块切换为在线模式。
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-chat
LLM_TEMPERATURE=0.2
LLM_TIMEOUT=120
LLM_MAX_TOKENS=2048

EMBEDDING_PROVIDER=hash
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIM=384

DATA_DIR=./data
DB_PATH=./data/app.db

CHUNK_SIZE=900
CHUNK_OVERLAP=120
RETRIEVE_TOP_K=8
DUP_THRESHOLD=0.45
REF_MATCH_THRESHOLD=0.72

OCR_ENABLED=1
OCR_LANG=ch

CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
