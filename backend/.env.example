# LLM 接入：任意 OpenAI 兼容网关（DeepSeek / Qwen / OpenAI / 本地 vLLM 均可）
# 没有配置 API Key 时系统进入离线演示模式：RAG 走抽取式回答，Agent 走规则路由。
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-chat
LLM_TEMPERATURE=0.2
LLM_TIMEOUT=120
LLM_MAX_TOKENS=2048

# Embedding：auto=有 API Key 用同网关，无 Key 自动回退本地哈希向量（零依赖）
EMBEDDING_PROVIDER=hash
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIM=384

# 数据目录
DATA_DIR=./data
DB_PATH=./data/app.db

# 检索 / 去重
CHUNK_SIZE=900
CHUNK_OVERLAP=120
RETRIEVE_TOP_K=8
DUP_THRESHOLD=0.45
REF_MATCH_THRESHOLD=0.72

# OCR
OCR_ENABLED=1
OCR_LANG=ch

# 跨域
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
